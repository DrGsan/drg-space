# Generate with python3 scripts/init-env.py. Keep APP_SECRET unchanged after setup.
# The generator copies this full template, including comments, and fills only
# the five installation secrets. Optional connections remain empty.
# Existing installations: keep your .env and DATABASE_SCHEMA unchanged.
APP_SECRET=
SETUP_TOKEN=
DATA_ENCRYPTION_ENABLED=true
# Independent random 32-byte base64 key. Generated by scripts/init-env.py.
DATA_ENCRYPTION_KEY=
# Empty means local SQLite. PostgreSQL database must already exist.
# DATABASE_URL=postgresql://drg:password@db.example.com:5432/drg?sslmode=verify-full
DATABASE_URL=
# PostgreSQL schema for NEW installations. Existing drg/custom schemas stay as-is.
DATABASE_SCHEMA=drg_site
# Optional shared encrypted counters. Empty keeps SQL-only operation.
# Use redis://user:password@host:6379/0 or rediss:// for TLS; no URL query options.
# Example: redis://redis.example.com:6379/0
REDIS_URL=
# Used only with compose.postgres.yaml; init-env.py generates a URL-safe value.
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
PUBLIC_URL=http://localhost:8000

# Optional per-user Notion OAuth integration. Disabled without credentials.
# One public Notion OAuth app; writes require the per-subtree experimental switch.
# Personal access/refresh tokens belong to encrypted account records, not .env.
NOTION_SYNC_ENABLED=false
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
# Empty callback derives PUBLIC_URL + /api/notion-sync/oauth/callback (HTTPS).
NOTION_OAUTH_REDIRECT_URI=
# Optional webhook signing tokens supplied by Notion, never generated here.
NOTION_WEBHOOK_READ_SECRET=
# Message pushes are enabled on HTTPS; set false to disable sending.
WEB_PUSH_ENABLED=true
# Voice calls: comma-separated STUN/TURN addresses; coturn use-auth-secret.
CALL_STUN_URLS=stun:stun.cloudflare.com:3478
CALL_TURN_URLS=
# Shared coturn secret, at least 16 characters (32+ recommended); never sent to browsers.
CALL_TURN_SECRET=
# Optional SFU for group invitation calls. Personal/federated calls use TURN above.
# Both services are optional. Group calls require LiveKit; there is no mesh fallback.
CALL_LIVEKIT_ENABLED=false
CALL_LIVEKIT_URL=
CALL_LIVEKIT_API_KEY=
CALL_LIVEKIT_API_SECRET=
# Optional server-to-server URL (HTTP on a trusted LAN or HTTPS); otherwise use public HTTPS.
CALL_LIVEKIT_API_URL=
DATA_DIR=./data
# DATA_DIR applies to direct Python launches. Compose uses the drg-data volume
# mounted at /data; changing DATA_DIR here does not relocate that volume.
# Workers share one local volume; replicas on different hosts are unsupported.
GUNICORN_WORKERS=1
GUNICORN_THREADS=64
# Production only (Caddy):
# Set the hostname here and the matching https:// URL in PUBLIC_URL above.
SITE_DOMAIN=

# Direct launch: do not trust forwarded headers. Production compose trusts only Caddy.
TRUSTED_PROXIES=
AUTH_FAILURE_LIMIT=8
AUTH_IP_FAILURE_LIMIT=30
AUTH_FAILURE_WINDOW=900
AUTH_BAN_SECONDS=900
AUTH_MAX_BAN_SECONDS=86400

# Optional outbound HTTPS proxy with a private root; see compose.proxy.yaml / INSTALL.md.
# OUTBOUND_CA_FILE is the absolute path to the combined CA bundle on the host.
# These settings reach Docker only with compose.proxy.yaml.
OUTBOUND_CA_FILE=
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# Optional Cloudflare Tunnel overlay; token contents stay in a separate file.
# Used only with compose.cloudflare.yaml; see docs/cloudflare-tunnel.md.
CLOUDFLARED_TOKEN_FILE=./.cloudflare-tunnel.token
CLOUDFLARED_UID=1000
CLOUDFLARED_GID=1000

# Optional files and archives; quota is managed per account in the admin UI.
FILE_STORAGE=local
# Per file, in MiB; 10240 = 10 GiB. Allowed range: 1..25600.
MAX_FILE_SIZE_MB=10240
ARCHIVE_MAX_GB=50
# S3 is optional and applies to file objects, not gallery/avatar/page thumbnails.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_PREFIX=drg-site
S3_ADDRESSING_STYLE=path
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Commons works without a key. Unsplash is hidden until its API Access Key is set:
UNSPLASH_ACCESS_KEY=

# Optional standalone DrG Media archive service. Empty values hide the module.
FAMILY_PHOTO_URL=
FAMILY_PHOTO_TOKEN=

# Optional server federation. Enable explicitly in People after configuring HTTPS.
# Direct mTLS endpoint: TCP forwarding must preserve TLS/client certificates.
# Empty URL derives https://<PUBLIC_URL hostname>:8444.
FEDERATION_PUBLIC_URL=
# Optional compose.federation.yaml host publishing; container port is 8444.
# The base compose.yaml publishes no federation port.
FEDERATION_BIND_ADDRESS=127.0.0.1
FEDERATION_PORT=8444
# Direct Python launch only; Compose keeps the internal port fixed at 8444.
# FEDERATION_BIND_PORT=8444
# Optional existing TLS certificate/key pair for a direct Python launch:
# FEDERATION_TLS_CERT=
# FEDERATION_TLS_KEY=

# Optional provider identification for weather requests. Supply your own application
# name and a reachable contact website/email; blank uses DrG Space and PUBLIC_URL.
# See https://api.met.no/doc/TermsOfService. Never use another installation's identity.
WEATHER_USER_AGENT=
