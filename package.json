{
  "name": "drg-space",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/dependency-notices.mjs --check && node scripts/i18n-check.mjs && node build.mjs",
    "test:clock": "node --test tests/clock-format.test.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:resources": "node scripts/i18n-check.mjs --write-resources",
    "test:i18n": "npm run i18n:check && node --test tests/i18n.test.mjs",
    "test:i18n:browser": "playwright test --config playwright.localization.config.js",
    "licenses:update": "node scripts/dependency-notices.mjs"
  },
  "dependencies": {
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@mantine/core": "9.7.2",
    "dompurify": "^3.4.17",
    "emojibase-data": "17.0.0",
    "i18next": "^26.5.11",
    "katex": "0.19.0",
    "livekit-client": "2.23.0",
    "lottie-web": "5.13.0",
    "marked": "^18.1.1",
    "mermaid": "12.2.0",
    "prosemirror-highlight": "0.15.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "4.5.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.8",
    "@playwright/test": "^1.64.0",
    "esbuild": "^0.28.2",
    "parse5": "8.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "packageManager": "npm@12.2.0"
}
